{
  "name": "eclipse-discord-bot",
  "version": "1.0.0",
  "description": "Discord bot that plays music from Eclipse addons in voice channels",
  "main": "bot.js",
  "type": "module",
  "scripts": {
    "start": "node bot.js",
    "dev": "node --watch bot.js",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "discord.js": "^14.16.0",
    "@discordjs/voice": "^0.18.0",
    "@discordjs/opus": "^0.10.0",
    "opusscript": "^0.1.1",
    "@snazzah/davey": "^1.0.0",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "^0.7.15",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
